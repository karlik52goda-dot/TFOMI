rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMemberList(members) {
      return members is list &&
             members.size() >= 1 &&
             members.size() <= 2 &&
             members[0] is string &&
             members[0].size() >= 1 &&
             members[0].size() <= 128 &&
             (members.size() == 1 || (members[1] is string && members[1].size() >= 1 && members[1].size() <= 128 && members[1] != members[0]));
    }

    function isValidRoom(data, roomId) {
      return data.keys().hasAll([
               'roomCode', 'hostUid', 'hostName', 'guestUid', 'guestName',
               'mode', 'status', 'floor', 'seed', 'winnerUid', 'memberUids',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'roomCode', 'hostUid', 'hostName', 'guestUid', 'guestName',
               'mode', 'status', 'floor', 'seed', 'winnerUid', 'memberUids',
               'createdAt', 'updatedAt'
             ]) &&
             data.roomCode is string && data.roomCode == roomId && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 40 &&
             data.guestUid is string && data.guestUid.size() <= 128 &&
             data.guestName is string && data.guestName.size() <= 40 &&
             data.mode in ['coop', 'pvp'] &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.floor is int && data.floor >= 1 && data.floor <= 999 &&
             data.seed is int && data.seed >= 0 &&
             data.winnerUid is string && data.winnerUid.size() <= 128 &&
             isValidMemberList(data.memberUids) &&
             data.memberUids[0] == data.hostUid &&
             (
               (data.guestUid == '' && data.memberUids.size() == 1) ||
               (data.guestUid != '' && data.memberUids.size() == 2 && data.memberUids[1] == data.guestUid)
             ) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomPlayer(data, roomId, playerId) {
      return data.keys().hasAll([
               'uid', 'roomId', 'memberUids', 'displayName', 'skinKey',
               'roomGx', 'roomGy', 'x', 'y', 'vx', 'vy',
               'hp', 'maxHp', 'shield', 'score', 'facingRight', 'alive',
               'shotSeq', 'shotX', 'shotY', 'shotVx', 'shotVy',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'uid', 'roomId', 'memberUids', 'displayName', 'skinKey',
               'roomGx', 'roomGy', 'x', 'y', 'vx', 'vy',
               'hp', 'maxHp', 'shield', 'score', 'facingRight', 'alive',
               'shotSeq', 'shotX', 'shotY', 'shotVx', 'shotVy',
               'createdAt', 'updatedAt'
             ]) &&
             data.uid is string && data.uid == playerId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.roomId is string && data.roomId == roomId &&
             isValidMemberList(data.memberUids) &&
             data.uid in data.memberUids &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.skinKey is string && data.skinKey.size() >= 1 && data.skinKey.size() <= 32 &&
             data.roomGx is int && data.roomGx >= -10 && data.roomGx <= 10 &&
             data.roomGy is int && data.roomGy >= -10 && data.roomGy <= 10 &&
             data.x is number && data.x >= -200 && data.x <= 2000 &&
             data.y is number && data.y >= -200 && data.y <= 2000 &&
             data.vx is number && data.vx >= -3000 && data.vx <= 3000 &&
             data.vy is number && data.vy >= -3000 && data.vy <= 3000 &&
             data.hp is int && data.hp >= 0 && data.hp <= 100 &&
             data.maxHp is int && data.maxHp >= 2 && data.maxHp <= 100 &&
             data.shield is int && data.shield >= 0 && data.shield <= 100 &&
             data.score is int && data.score >= 0 && data.score <= 10000000 &&
             data.facingRight is bool &&
             data.alive is bool &&
             data.shotSeq is int && data.shotSeq >= 0 && data.shotSeq <= 10000000 &&
             data.shotX is number && data.shotX >= -500 && data.shotX <= 2500 &&
             data.shotY is number && data.shotY >= -500 && data.shotY <= 2500 &&
             data.shotVx is number && data.shotVx >= -4000 && data.shotVx <= 4000 &&
             data.shotVy is number && data.shotVy >= -4000 && data.shotVy <= 4000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() &&
                    isValidId(roomId) &&
                    (request.auth.uid in existing().memberUids || existing().status == 'waiting');

      allow list: if isSignedIn() &&
                     (request.auth.uid in existing().memberUids || existing().status == 'waiting');

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming(), roomId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().guestUid == '' &&
                       incoming().guestName == '' &&
                       incoming().status == 'waiting' &&
                       incoming().winnerUid == '' &&
                       incoming().floor == 1 &&
                       incoming().memberUids.size() == 1;

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming(), roomId) &&
                       existing().status != 'finished' &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Guest joins an open waiting room
                         (
                           existing().status == 'waiting' &&
                           existing().guestUid == '' &&
                           request.auth.uid != existing().hostUid &&
                           incoming().guestUid == request.auth.uid &&
                           incoming().status == 'waiting' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['guestUid', 'guestName', 'memberUids', 'updatedAt'])
                         ) ||
                         // Action 2: Joined guest leaves before match starts
                         (
                           existing().status == 'waiting' &&
                           request.auth.uid == existing().guestUid &&
                           incoming().guestUid == '' &&
                           incoming().guestName == '' &&
                           incoming().status == 'waiting' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['guestUid', 'guestName', 'memberUids', 'updatedAt'])
                         ) ||
                         // Action 3: Host updates mode while waiting, starts match, or advances floor while playing
                         (
                           request.auth.uid == existing().hostUid &&
                           (
                             (existing().status == 'waiting' && incoming().status in ['waiting', 'playing']) ||
                             (existing().status == 'playing' && incoming().status in ['playing', 'finished'])
                           ) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['mode', 'status', 'floor', 'seed', 'winnerUid', 'updatedAt'])
                         ) ||
                         // Action 4: Any room participant finishes an active match
                         (
                           request.auth.uid in existing().memberUids &&
                           existing().status == 'playing' &&
                           incoming().status == 'finished' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'winnerUid', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(roomId) &&
                       request.auth.uid == existing().hostUid;

      match /players/{playerId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(playerId) &&
                      (request.auth.uid == playerId || request.auth.uid in existing().memberUids);

        allow list: if isSignedIn() &&
                       request.auth.uid in existing().memberUids;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         request.auth.uid == playerId &&
                         isValidRoomPlayer(incoming(), roomId, playerId) &&
                         existsAfter(/databases/$(database)/documents/rooms/$(roomId)) &&
                         request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids &&
                         incoming().memberUids == getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         isValidRoomPlayer(incoming(), roomId, playerId) &&
                         incoming().uid == existing().uid &&
                         incoming().roomId == existing().roomId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action 1: Player updates their own live gameplay state & skin
                           (
                             request.auth.uid == playerId &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'displayName', 'skinKey', 'roomGx', 'roomGy',
                               'x', 'y', 'vx', 'vy', 'hp', 'maxHp', 'shield',
                               'score', 'facingRight', 'alive',
                               'shotSeq', 'shotX', 'shotY', 'shotVx', 'shotVy',
                               'updatedAt'
                             ])
                           ) ||
                           // Action 2: Room participant syncs denormalized memberUids to match parent room
                           (
                             existsAfter(/databases/$(database)/documents/rooms/$(roomId)) &&
                             request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids &&
                             incoming().memberUids == getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                           )
                         );

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         (request.auth.uid == playerId ||
                          (exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                           get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid));
      }
    }
  }
}
